# Edge runtime only. Never prefix private values with VITE_.
# Self-hosting normally injects SUPABASE_URL and SUPABASE_ANON_KEY.
CREW_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
# Used by the standard Supabase CLI entrypoint (crew-api/index.ts) only. On
# the self-hosted sbp platform this is injected at build time instead (see
# scripts/build-crew-api.mjs / docs/FRONTEND-HANDOFF.ko.md) because custom env
# vars are not on that platform's runtime allowlist.
CREW_PROJECT_ID=
# Postgres connection used directly by the Edge Function (postgres.js), not
# PostgREST. On sbp this is provided as SUPABASE_DB_URL by the platform - only
# set it here for the standard Supabase CLI / self-managed stacks.
SUPABASE_DB_URL=
