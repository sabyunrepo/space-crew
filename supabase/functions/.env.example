# Edge runtime only. Never prefix private values with VITE_.
# Self-hosting normally injects SUPABASE_URL and SUPABASE_ANON_KEY.
CREW_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
# Reserved for the future Postgres repository (unused by PendingRepository).
# Use a dedicated LOGIN role that can SET ROLE crew_server; require TLS in production.
CREW_DATABASE_URL=
