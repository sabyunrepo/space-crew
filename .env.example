VITE_BACKEND_MODE=mock
# 실제 연동 시 supabase 또는 server로 변경합니다. 자동으로 데모로 대체하지 않습니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 기본: {VITE_SUPABASE_URL}/functions/v1/crew-api
VITE_CREW_API_URL=
# 프로젝트 UUID(관리 콘솔 주소가 아님). private broadcast 토픽 sbp:<이 값>:<auth uid> 구독에 사용합니다.
VITE_SUPABASE_PROJECT_ID=

# server 모드: Node 실시간 서버(server/) + ServerService를 사용합니다.
# 빌드 시 VITE_BACKEND_MODE=server로 설정하면 같은 origin의 /api, /ws를 사용하므로
# 프론트에 별도 서버 주소를 지정할 필요가 없습니다. 서버 실행 시 아래 값을 설정하세요.
# PORT=8080
# DATA_DIR=/data

# DB 모드: CREW_DB_URL을 설정하면 Node 서버가 Supabase Postgres에 직접 붙어
# /api/crew에서 게임 API를 직접 처리합니다(옛 파일 저장 방식의 /api/*, /ws는 꺼집니다).
# 넷 다 있어야 켜집니다.
# CREW_DB_URL=postgres://crew_api:<password>@<host>:5432/postgres
# CREW_JWT_SECRET=
# CREW_PROJECT_ID=
# CREW_ALLOWED_ORIGINS=https://crew.bsh00.com
# 빌드 시 VITE_CREW_API_URL=/api/crew로 설정하면 같은 origin의 /api/crew를 씁니다.
# VITE_CREW_API_URL=/api/crew
