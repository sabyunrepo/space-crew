{
  "name": "mission-crew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run assets && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "assets": "node tools/prepare-web-assets.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
